# TaskLoop API configuration
# Copy this file to .env and fill in your values.

# MongoDB connection string
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/taskloop
# MongoDB Atlas (free) example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/taskloop?retryWrites=true&w=majority

# Secret used to sign session tokens - use a long random string
JWT_SECRET=change-me-to-a-long-random-string

# Port for the API server
PORT=4000

# Allowed frontend origin for CORS (your GitHub Pages URL, or leave as * for dev)
CLIENT_ORIGIN=*
